LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
DATA_DIR=./data

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
MIN_SCORE=0.35

# groq | openai | azure_openai | anthropic | bedrock | ollama
LLM_PROVIDER=groq
# Exact Groq model ID from https://console.groq.com/docs/models
# (example: llama-3.3-70b-versatile; Groq retires models, so check the page)
LLM_MODEL=<your-groq-model-id>
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024

# Provider credentials (read by the provider SDKs)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Bedrock uses AWS credentials / IAM role. Set the region:
AWS_REGION=ap-south-1
